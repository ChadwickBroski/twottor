rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDebugAdmin() {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == 'abhay';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
                            && request.auth.uid == userId;
      allow update: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || (
                        isDebugAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'interestScores', 'interestActionCount', 'interestUpdatedAt'
                        ])
                      )
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalLikes', 'totalDislikes', 'totalViews'])
                        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalLikes', 'totalDislikes', 'totalViews'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalLikes']) || request.resource.data.totalLikes is int || request.resource.data.totalLikes is float)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalDislikes']) || request.resource.data.totalDislikes is int || request.resource.data.totalDislikes is float)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalViews']) || request.resource.data.totalViews is int || request.resource.data.totalViews is float)
                      )
                    );
    }

    match /handles/{handle} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'handle'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.handle == handle;

      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.handle == handle;

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.auth.token.email_verified == true
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasOnly([
                        'text', 'uid', 'userEmail', 'username', 'handle', 'createdAt'
                      ])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280;
        allow update, delete: if request.auth != null
                              && resource.data.uid == request.auth.uid;
      }

      function isNumeric(value) {
        return value is int || value is float;
      }

      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
                    && (
                      (
                        isDebugAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topic', 'topicScores'])
                      )
                      || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'likeCount', 'dislikeCount'])
                        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount', 'likeCount', 'dislikeCount'])
                        && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount'])
                        || (
                          isNumeric(request.resource.data.viewCount)
                          && (
                            (isNumeric(resource.data.get('viewCount', 0))
                              && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1)
                            || (!isNumeric(resource.data.get('viewCount', 0))
                              && request.resource.data.viewCount == 1)
                          )
                        )
                        )
                        && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount'])
                        || (
                          request.resource.data.likeCount is int
                          && resource.data.get('likeCount', 0) is int
                          && (
                            (
                              request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
                              && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedPosts', []).hasAny([postId])
                              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedPosts', []).hasAny([postId])
                            )
                            ||
                            (
                              resource.data.get('likeCount', 0) > 0
                              && request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
                              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedPosts', []).hasAny([postId])
                              && !getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedPosts', []).hasAny([postId])
                            )
                          )
                        )
                        )
                        && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['dislikeCount'])
                        || (
                          request.resource.data.dislikeCount is int
                          && resource.data.get('dislikeCount', 0) is int
                          && (
                            (
                              request.resource.data.dislikeCount == resource.data.get('dislikeCount', 0) + 1
                              && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dislikedPosts', []).hasAny([postId])
                              && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dislikedPosts', []).hasAny([postId])
                            )
                            ||
                            (
                              resource.data.get('dislikeCount', 0) > 0
                              && request.resource.data.dislikeCount == resource.data.get('dislikeCount', 0) - 1
                              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dislikedPosts', []).hasAny([postId])
                              && !getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('dislikedPosts', []).hasAny([postId])
                            )
                          )
                        )
                        )
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
